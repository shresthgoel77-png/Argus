# The URL of the internal scheduling endpoint of the backend
BACKEND_URL="https://your-production-backend.com/api/v1/internal/scheduled-monitoring/run"

# Note: The secret below must match the SCHEDULER_SHARED_SECRET used in the backend.
# DO NOT add the secret permanently to this file or commit it.
# For local dev via `wrangler dev` or `wrangler trigger`, copy this file to `.dev.vars`
# and put your secret there:
SCHEDULER_SHARED_SECRET="your-development-secret-here"
