# ==============================================================================
# WARNING: DEMO REHEARSAL CONFIGURATION
# 
# These values trade precision and safety margins for fast demo pacing.
# They are strictly for live 5-minute demonstrations and should NOT be used 
# as production defaults. (See .env.example for true defaults).
# ==============================================================================

# Enable rehearsal-only routes (e.g. /demo/reset-data)
DEMO_MODE=true

# Faster background-loop visibility if not using manual trigger (was default 10)
DETECTION_POLL_INTERVAL_SECONDS=5

# Must still be long enough for real recovery to show given real traffic; 
# do not set below ~20s or genuine recovery may not have settled (was default 60)
VERIFICATION_MAX_WAIT_SECONDS=30

# More frequent checks within the shorter max wait (was default 10)
VERIFICATION_POLL_INTERVAL_SECONDS=5

DATABASE_URL=your-key-here
# Only needs Issues: write on the target repo. Never logged or returned in API responses.
GITHUB_TOKEN=your-key-here
GITHUB_REPO=your-key-here
AI_API_KEY=your-key-here
RAZORPAY_KEY_ID=your-key-here
RAZORPAY_KEY_SECRET=your-key-here
RAZORPAY_WEBHOOK_SECRET=your-key-here
PROMETHEUS_URL=your-key-here
LOKI_URL=your-key-here
