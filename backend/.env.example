# Valid values for APP_ENV: development, test, production
APP_ENV=development
DATABASE_URL=postgresql://repomedic_user:repomedic_password@localhost:5432/repomedic_db
TEST_DATABASE_URL=postgresql://repomedic_user:repomedic_password@localhost:5432/repomedic_test
CORS_ORIGINS=http://localhost:3000
# Production must explicitly list the browser frontend origin(s), comma-separated.
# API_RATE_LIMIT_REQUESTS=120
# API_RATE_LIMIT_WINDOW_SECONDS=60

# AI BYOK generation safeguards (process-local; enforce shared limits at ingress
# for multi-worker/multi-instance deployments). Groq organization quotas vary.
# AI_USER_REQUESTS_PER_MINUTE=8
# AI_GLOBAL_REQUESTS_PER_MINUTE=60
# AI_PROVIDER_MODEL_REQUESTS_PER_MINUTE=30
# AI_GLOBAL_CONCURRENCY=8
# AI_USER_CONCURRENCY=2
# AI_REQUEST_TIMEOUT_SECONDS=20
# AI_MAX_INPUT_CHARS=24000
# AI_MAX_OUTPUT_TOKENS=900
# AI_CACHE_TTL_SECONDS=120
# AI_CACHE_MAX_ENTRIES=256
# AI_RETRY_BASE_DELAY_SECONDS=0.25
# AI_RETRY_MAX_DELAY_SECONDS=2

# Clerk is the only supported application auth provider.
AUTH_PROVIDER=clerk

# Clerk auth config (required when AUTH_PROVIDER=clerk)
# CLERK_SECRET_KEY=sk_live_xxx
# CLERK_JWT_KEY=<PEM public key for local JWT verification>
# Set this to the trusted browser frontend origin(s), including in production.
# CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]

# GitHub App ID for the application
GITHUB_APP_ID=5306913
# GitHub App Slug used to build the installation URL
GITHUB_APP_SLUG=argus-og
# Webhook secret; this must match the webhook secret configured on the GitHub App itself
GITHUB_APP_WEBHOOK_SECRET=my_webhook_secret_here
# Private key PEM from your GitHub App settings — paste as a single env value
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# TTL in seconds for the GitHub App installation CSRF state token
GITHUB_APP_INSTALL_STATE_TTL_SECONDS=600

# Base64 URL-safe string (32 bytes) for AI Credential Encryption
AI_CREDENTIAL_ENCRYPTION_KEY=your_urlsafe_base64_fernet_key_here

WEBHOOK_URL=https://mashing-congested-unspoiled.ngrok-free.dev/api/v1/webhooks/github