# Valid values for APP_ENV: development, test, production
APP_ENV=development
DATABASE_URL=postgresql://repomedic_user:repomedic_password@localhost:5432/repomedic_db
TEST_DATABASE_URL=postgresql://repomedic_user:repomedic_password@localhost:5432/repomedic_test
CORS_ORIGINS=http://localhost:3000

# Auth provider. In production, this must not be 'development'.
AUTH_PROVIDER=development
